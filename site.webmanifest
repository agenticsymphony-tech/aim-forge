{
  "name": "AIMFORGE: 3D Aim Trainer by Apurva",
  "short_name": "AIMFORGE",
  "description": "First-person 3D aim trainer in your browser.",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "orientation": "landscape",
  "background_color": "#07080c",
  "theme_color": "#ff2b3d",
  "icons": [
